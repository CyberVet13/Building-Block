{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL":               "@bb-api-url",
    "NEXT_PUBLIC_APP_URL":               "@bb-app-url",
    "NEXT_PUBLIC_COGNITO_USER_POOL_ID":  "@bb-cognito-pool-id",
    "NEXT_PUBLIC_COGNITO_CLIENT_ID":     "@bb-cognito-client-id",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "@bb-stripe-publishable-key"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/:path*"
    }
  ]
}
